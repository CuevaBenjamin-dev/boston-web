---
interface Props {
  lang?: 'es' | 'en';
  variant?: 'default' | 'landing';
}

const { lang = 'es', variant = 'default' } = Astro.props;

const apiBaseUrl = (import.meta.env.PUBLIC_API_URL ?? '').replace(/\/$/, '');
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';

const labels = {
  es: {
    title: 'Ficha de admisión',
    studentSection: 'Datos del Estudiante',
    studentFirstNames: 'Nombres',
    studentPaternalSurname: 'Apellido paterno',
    studentMaternalSurname: 'Apellido materno',
    studentAge: 'Edad',
    grade: 'Grado al que desea ingresar',
    previousSchool: 'Institución educativa de procedencia',
    previousSchoolHint: 'Si aún no asiste a una institución, escribe “No aplica”.',
    parentSection: 'Datos del Apoderado',
    parentName: 'Nombre completo',
    parentRelationship: 'Parentesco con el estudiante',
    parentPhone: 'Celular',
    parentEmail: 'Correo electrónico',
    preferredContact: 'Medio de contacto preferido',
    phone: 'Celular',
    whatsapp: 'WhatsApp',
    email: 'Email',
    anotherChild: 'Registraré a otro estudiante después de este envío',
    anotherChildHint: 'Conservaremos los datos del apoderado y podrás completar los del siguiente estudiante.',
    nextStudent: 'Completar siguiente estudiante',
    submit: 'Solicitar admisión',
    success: '¡Solicitud de admisión recibida! Nos comunicaremos contigo pronto.',
    successNext: '¡Solicitud recibida! Conservamos los datos del apoderado. Completa ahora los del siguiente estudiante.',
    error: 'Error al enviar la postulación. Intenta nuevamente.',
  },
  en: {
    title: 'Admission form',
    studentSection: 'Student Information',
    studentFirstNames: 'Given names',
    studentPaternalSurname: 'Paternal surname',
    studentMaternalSurname: 'Maternal surname',
    studentAge: 'Age',
    grade: 'Grade the student wishes to enter',
    previousSchool: 'Previous school or institution',
    previousSchoolHint: 'If the student has not attended one, enter “Not applicable”.',
    parentSection: 'Parent/Guardian Information',
    parentName: 'Full name',
    parentRelationship: 'Relationship to the student',
    parentPhone: 'Mobile number',
    parentEmail: 'Email address',
    preferredContact: 'Preferred contact method',
    phone: 'Mobile call',
    whatsapp: 'WhatsApp',
    email: 'Email',
    anotherChild: 'I will register another student after this submission',
    anotherChildHint: 'We will keep the parent/guardian details so you can enter the next student.',
    nextStudent: 'Enter next student',
    submit: 'Request admission',
    success: 'Admission request received! We will contact you soon.',
    successNext: 'Request received! Your parent/guardian details remain. Now enter the next student.',
    error: 'Error sending application. Please try again.',
  },
};

const t = labels[lang];
---

<div class:list={["admissions-form-container", { "admissions-form-container--landing": variant === "landing" }]}>
  <h3 class="form-title">{t.title}</h3>

  <form id="admissionsForm" class="admissions-form">
    {/* Student Section */}
    <fieldset class="form-section">
      <legend class="section-title">{t.studentSection}</legend>

      <div class="form-group">
        <label for="studentFirstNames">{t.studentFirstNames} *</label>
        <input type="text" id="studentFirstNames" name="studentFirstNames" minlength="2" maxlength="50"
          autocomplete="given-name" placeholder={lang === 'es' ? 'Ej: Juan Carlos' : 'Ex: John Michael'} required />
      </div>

      <div class="form-row">
        <div class="form-group">
          <label for="studentPaternalSurname">{t.studentPaternalSurname} *</label>
          <input type="text" id="studentPaternalSurname" name="studentPaternalSurname" minlength="2" maxlength="40"
            placeholder={lang === 'es' ? 'Ej: Pérez' : 'Ex: Pérez'} required />
        </div>
        <div class="form-group">
          <label for="studentMaternalSurname">{t.studentMaternalSurname}</label>
          <input type="text" id="studentMaternalSurname" name="studentMaternalSurname" minlength="2" maxlength="40"
            placeholder={lang === 'es' ? 'Ej: García (si corresponde)' : 'Ex: García (if applicable)'} />
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label for="studentAge">{t.studentAge} *</label>
          <input
            type="number"
            id="studentAge"
            name="studentAge"
            placeholder={lang === 'es' ? 'Ej: 10' : 'Ex: 10'}
            min="5"
            max="18"
            required
          />
        </div>

        <div class="form-group">
          <label for="grade">{t.grade} *</label>
          <select id="grade" name="grade" required>
            <option value="">{lang === 'es' ? 'Seleccionar grado' : 'Select grade'}</option>
            {[1, 2, 3, 4, 5, 6].map((n) => <option value={`primaria_${n}`}>{lang === 'es' ? `${n}° Primaria` : `Primary ${n}`}</option>)}
            {[1, 2, 3, 4, 5].map((n) => <option value={`secundaria_${n}`}>{lang === 'es' ? `${n}° Secundaria` : `Secondary ${n}`}</option>)}
          </select>
        </div>
      </div>

      <div class="form-group">
        <label for="previousSchool">{t.previousSchool} *</label>
        <input type="text" id="previousSchool" name="previousSchool" minlength="2" maxlength="150"
          placeholder={lang === 'es' ? 'Colegio, nido o institución' : 'School or institution'} required />
        <small class="form-hint">{t.previousSchoolHint}</small>
      </div>
    </fieldset>

    {/* Parent Section */}
    <fieldset class="form-section">
      <legend class="section-title">{t.parentSection}</legend>

      <div class="form-group">
        <label for="parentName">{t.parentName} *</label>
        <input
          type="text"
          id="parentName"
          name="parentName"
          placeholder={lang === 'es' ? 'Ej: Carlos García' : 'Ex: John Smith'}
          required
        />
      </div>

      <div class="form-group">
        <label for="parentRelationship">{t.parentRelationship} *</label>
        <input type="text" id="parentRelationship" name="parentRelationship" minlength="2" maxlength="60"
          placeholder={lang === 'es' ? 'Ej: madre, padre o tutor(a)' : 'Ex: mother, father or guardian'} required />
      </div>

      <div class="form-row">
        <div class="form-group">
          <label for="parentPhone">{t.parentPhone} *</label>
          <input
            type="tel"
            id="parentPhone"
            name="parentPhone"
            placeholder="+51 976 586 016"
            autocomplete="tel"
            required
          />
        </div>

        <div class="form-group">
          <label for="parentEmail">{t.parentEmail} *</label>
          <input
            type="email"
            id="parentEmail"
            name="parentEmail"
            placeholder="correo@ejemplo.com"
            required
          />
        </div>
      </div>

      <div class="form-group">
        <label for="preferredContact">{t.preferredContact}</label>
        <select id="preferredContact" name="preferredContact">
          <option value="phone">{t.phone}</option>
          <option value="whatsapp">{t.whatsapp}</option>
          <option value="email">{t.email}</option>
        </select>
      </div>
    </fieldset>

    <div class="additional-student">
      <label for="anotherChild"><input type="checkbox" id="anotherChild" name="anotherChild" /><span>{t.anotherChild}</span></label>
      <p>{t.anotherChildHint}</p>
    </div>

    {turnstileSiteKey && <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-action="postulacion" data-size="flexible" data-appearance="interaction-only"></div>}

    {/* Message */}
    <div id="formMessage" class="form-message" role="status" aria-live="polite" style="display: none;"></div>
    <button type="button" class="next-student-button" id="nextStudentBtn" hidden>{t.nextStudent}</button>

    {/* Submit Button */}
    <button type="submit" class="submit-button" id="submitBtn">
      {t.submit}
    </button>
  </form>
</div>

{turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
<script define:vars={{ lang, apiBaseUrl, turnstileSiteKey }} data-astro-rerun>
  function initForm() {
    const form = document.getElementById('admissionsForm');
    const submitBtn = document.getElementById('submitBtn');
    const messageDiv = document.getElementById('formMessage');
    const nextStudentBtn = document.getElementById('nextStudentBtn');

    if (!form) {
      console.error('Formulario no encontrado');
      return;
    }
    if (form.dataset.initialized) return;
    form.dataset.initialized = 'true';

    const messages = {
      es: {
        success: '¡Solicitud de admisión recibida! Nos comunicaremos contigo pronto.',
        successNext: '¡Solicitud recibida! Conservamos los datos del apoderado. Completa ahora los del siguiente estudiante.',
        error: 'Error al enviar la postulación. Intenta nuevamente.',
        sending: 'Enviando...',
        submit: 'Solicitar admisión',
      },
      en: {
        success: 'Admission request received! We will contact you soon.',
        successNext: 'Request received! Your parent/guardian details remain. Now enter the next student.',
        error: 'Error sending application. Please try again.',
        sending: 'Sending...',
        submit: 'Request admission',
      },
    };

    nextStudentBtn.addEventListener('click', () => {
      document.getElementById('studentFirstNames')?.focus();
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const formData = new FormData(form);
      const data = {
        studentFirstNames: formData.get('studentFirstNames'),
        studentPaternalSurname: formData.get('studentPaternalSurname'),
        studentMaternalSurname: formData.get('studentMaternalSurname'),
        studentAge: formData.get('studentAge'),
        grade: formData.get('grade'),
        previousSchool: formData.get('previousSchool'),
        parentName: formData.get('parentName'),
        parentRelationship: formData.get('parentRelationship'),
        parentPhone: formData.get('parentPhone'),
        parentEmail: formData.get('parentEmail'),
        preferredContact: formData.get('preferredContact'),
        language: lang,
        turnstileToken: formData.get('cf-turnstile-response'),
      };
      const anotherChild = formData.get('anotherChild') === 'on';

      submitBtn.disabled = true;
      submitBtn.textContent = messages[lang].sending;
      messageDiv.style.display = 'none';
      nextStudentBtn.hidden = true;

      if (!apiBaseUrl || !turnstileSiteKey) {
        messageDiv.className = 'form-message form-message--error';
        messageDiv.textContent =
          lang === 'es' ? 'El servicio de postulaciones aún no está configurado.' : 'The application service is not configured yet.';
        messageDiv.style.display = 'block';

        submitBtn.disabled = false;
        submitBtn.textContent = messages[lang].submit;
        return;
      }
      if (!data.turnstileToken) {
        messageDiv.className = 'form-message form-message--error';
        messageDiv.textContent = lang === 'es' ? 'Completa la verificación de seguridad.' : 'Complete the security check.';
        messageDiv.style.display = 'block';
        submitBtn.disabled = false;
        submitBtn.textContent = messages[lang].submit;
        return;
      }

      try {
        const response = await fetch(`${apiBaseUrl}/api/postulaciones`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(data),
        });

        const result = await response.json();

        if (response.ok && result.ok === true) {
          messageDiv.className = 'form-message form-message--success';
          messageDiv.textContent = anotherChild ? messages[lang].successNext : messages[lang].success;
          form.reset();
          if (anotherChild) {
            for (const field of ['parentName', 'parentRelationship', 'parentPhone', 'parentEmail', 'preferredContact']) {
              const control = form.elements.namedItem(field);
              if (control) control.value = data[field];
            }
            form.elements.namedItem('anotherChild').checked = true;
            nextStudentBtn.hidden = false;
          }
        } else {
          messageDiv.className = 'form-message form-message--error';
          messageDiv.textContent = result.error || messages[lang].error;
        }

        messageDiv.style.display = 'block';
      } catch {
        messageDiv.className = 'form-message form-message--error';
        messageDiv.textContent = messages[lang].error;
        messageDiv.style.display = 'block';
      } finally {
        window.turnstile?.reset();
        submitBtn.disabled = false;
        submitBtn.textContent = messages[lang].submit;
      }
    });
  }

  // Ejecutar cuando el DOM esté listo
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initForm);
  } else {
    initForm();
  }
</script>

<style>
  .admissions-form-container {
    background: white;
    padding: 2rem;
    border-radius: 8px;
    max-width: 600px;
    margin: 0 auto;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }

  .form-title {
    color: var(--color-primary);
    font-size: 1.5rem;
    margin-bottom: 2rem;
    text-align: center;
    font-weight: 700;
  }

  .admissions-form {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .form-section {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
    border: none;
  }

  .form-section:last-of-type {
    border-bottom: none;
    padding-bottom: 0;
  }

  .section-title {
    color: var(--color-primary);
    font-size: 1.1rem;
    font-weight: 700;
    margin: 0;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .form-group label {
    color: var(--color-text);
    font-weight: 600;
    font-size: 0.9rem;
  }

  .form-hint {
    color: #617387;
    font-size: .78rem;
    line-height: 1.4;
  }

  .additional-student {
    padding: 18px 20px;
    border: 1px solid #dce7f1;
    border-radius: 10px;
    background: #f7faff;
  }

  .additional-student label {
    display: flex;
    align-items: flex-start;
    gap: 11px;
    color: #063e7d;
    font-size: .9rem;
    font-weight: 700;
    cursor: pointer;
  }

  .additional-student input {
    flex: none;
    width: 18px;
    height: 18px;
    margin: 1px 0 0;
    accent-color: #ff9900;
  }

  .additional-student p {
    margin: 8px 0 0 29px;
    color: #617387;
    font-size: .8rem;
    line-height: 1.45;
  }

  .next-student-button {
    padding: 11px 15px;
    border: 1px solid #06417f;
    border-radius: 7px;
    background: #fff;
    color: #06417f;
    font: 700 .88rem var(--font-accent);
    cursor: pointer;
  }

  .next-student-button[hidden] { display: none; }
  .next-student-button:focus-visible { outline: 3px solid #ff9900; outline-offset: 3px; }

  .form-group input,
  .form-group select {
    padding: 0.75rem;
    border: 1px solid #ddd;
    border-radius: 4px;
    font-size: 0.95rem;
    font-family: inherit;
    transition: border-color 0.3s ease;
  }

  .form-group input:focus,
  .form-group select:focus {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px rgba(255, 153, 0, 0.1);
  }

  .form-message {
    padding: 1rem;
    border-radius: 4px;
    text-align: center;
    font-weight: 500;
  }

  .form-message--success {
    background: #d4edda;
    color: #155724;
    border: 1px solid #c3e6cb;
  }

  .form-message--success::before {
    content: '✓';
    color: #168a4a;
    font-weight: 800;
    margin-right: 0.5rem;
  }

  .form-message--error {
    background: #f8d7da;
    color: #721c24;
    border: 1px solid #f5c6cb;
  }

  .submit-button {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-accent) 100%);
    color: white;
    padding: 1rem;
    border: none;
    border-radius: 4px;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .submit-button:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 8px 16px rgba(255, 153, 0, 0.3);
  }

  .submit-button:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }

  .admissions-form-container--landing {
    max-width: 760px;
    padding: 36px 56px 40px;
    border-radius: 22px;
    box-shadow: 0 16px 42px rgba(4, 64, 130, 0.09);
  }

  .admissions-form-container--landing .form-title {
    margin: 0 0 28px;
    color: #06417f;
    font-size: clamp(1.65rem, 2.7vw, 2.25rem);
    font-weight: 800;
    line-height: 1.2;
  }

  .admissions-form-container--landing .form-title::after {
    content: "";
    display: block;
    width: 47px;
    height: 3px;
    margin: 13px auto 0;
    background: #ff9900;
  }

  .admissions-form-container--landing .admissions-form {
    gap: 19px;
  }

  .admissions-form-container--landing .form-section {
    gap: 13px;
    padding: 0;
    margin: 0;
    min-width: 0;
  }

  .admissions-form-container--landing .section-title {
    padding: 0;
    margin-bottom: 7px;
    color: #06417f;
    font-size: 1.02rem;
    font-weight: 800;
  }

  .admissions-form-container--landing .form-group {
    gap: 5px;
    min-width: 0;
  }

  .admissions-form-container--landing .form-row {
    gap: 16px;
  }

  .admissions-form-container--landing .form-group label {
    color: #424b58;
    font-size: .87rem;
    font-weight: 700;
  }

  .admissions-form-container--landing .form-group input,
  .admissions-form-container--landing .form-group select {
    width: 100%;
    min-height: 45px;
    padding: 10px 13px;
    border: 1px solid #d9e0e8;
    border-radius: 6px;
    background: #fff;
    color: #243547;
    font-size: .91rem;
  }

  .admissions-form-container--landing .form-group input::placeholder {
    color: #8a939e;
  }

  .admissions-form-container--landing .submit-button {
    width: 100%;
    min-height: 52px;
    padding: 13px 20px;
    border-radius: 6px;
    background: #ff9900;
    background-image: none;
    color: #fff;
    font-family: var(--font-accent);
    font-weight: 700;
    transition: background-color .2s ease, box-shadow .2s ease;
  }

  .admissions-form-container--landing .submit-button:hover:not(:disabled) {
    background: #ec8500;
    transform: none;
    box-shadow: 0 7px 16px rgba(255, 153, 0, .22);
  }

  .admissions-form-container--landing .submit-button:focus-visible {
    outline: 3px solid #084b92;
    outline-offset: 3px;
  }

  @media (max-width: 768px) {
    .form-row {
      grid-template-columns: 1fr;
    }

    .admissions-form-container {
      padding: 1.5rem;
    }

    .admissions-form-container--landing {
      padding: 29px 23px 32px;
    }
  }
  @media (max-width: 420px) {
    .admissions-form-container--landing{width:calc(100% + 12px);margin-inline:-6px;padding:26px 18px 30px}
    .admissions-form-container--landing .form-title{font-size:1.6rem}
    .admissions-form-container--landing .form-group input,
    .admissions-form-container--landing .form-group select{font-size:1rem}
  }
</style>
