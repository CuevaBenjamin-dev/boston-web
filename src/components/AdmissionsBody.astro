---
import AdmissionsFormSimple from './AdmissionsFormSimple.astro';

type Section = 'overview' | 'process' | 'fees' | 'vacancies';
interface Props { lang: 'es' | 'en'; section?: Section }
const { lang, section = 'overview' } = Astro.props;
const base = `/${lang}/admisiones/`;
const applyHref = `${base}#postulacion`;
const routes: Record<Section, string> = {
  overview: base,
  process: `${base}como-postular/`,
  fees: `${base}pensiones/`,
  vacancies: `${base}vacantes/`,
};
const feePlans = {
  historical2026: { entry: 500, enrollment: 400, monthly: 550 },
  new2027: { entry: 500, enrollment: 400, monthly: 700 },
  continuing2027: { entry: null, enrollment: 200, monthly: 550 },
} as const;
const feePlanOrder = ['historical2026', 'new2027', 'continuing2027'] as const;
const pensionDueDates = ['31/03/2027', '30/04/2027', '31/05/2027', '30/06/2027', '31/07/2027', '31/08/2027', '30/09/2027', '31/10/2027', '30/11/2027', '13/12/2027'] as const;
const soles = (amount: number) => `S/ ${amount}`;

const copy = {
  es: {
    home: 'Inicio', admission: 'Admisión 2027', sideTitle: 'Explora admisiones',
    nav: { overview: 'Admisión de nuevos estudiantes', process: 'Cómo postular', fees: 'Pensiones escolares', vacancies: 'Vacantes disponibles' },
    sideHelp: '¿Necesitas orientación?', sideHelpText: 'Nuestro equipo puede ayudarte a resolver tus dudas antes de postular.', sideHelpLink: 'Contactar a Admisiones',
    apply: 'Solicitar admisión', consult: 'Consultar con Admisiones', more: 'Conoce el proceso',
    overview: {
      eyebrow: 'TU CAMINO COMIENZA AQUÍ', title: 'Un lugar para crecer, aprender y descubrir.',
      intro: 'En Boston Bilingual School abrimos nuestras puertas a las familias de Trujillo que buscan una educación bilingüe de excelencia, formación integral y proyección preuniversitaria internacional para sus hijos en Primaria y Secundaria.',
      detail: 'Nuestra propuesta promueve el pensamiento crítico, los valores y las competencias globales en un entorno inclusivo de sana convivencia escolar. Las vacantes son muy limitadas por sección para garantizar una atención personalizada y de calidad, conforme a la normativa del Ministerio de Educación y al Reglamento Interno de la institución.',
      processText: 'Para iniciar la postulación, completa la solicitud de admisión y presenta la documentación requerida, incluido el historial académico previo y, en caso de traslado, el certificado de buena conducta. Acompañamos a cada postulante en la evaluación y su adaptación a nuestra propuesta curricular e inmersión lingüística. Tras revisar los requisitos, comunicamos el resultado y la familia formaliza la vacante con la firma del compromiso de admisión y la matrícula.',
      imageAlt: 'Asesora de admisiones conversando con una familia', imageLabel: 'Una comunidad que acompaña',
      levelsTitle: 'Una formación para cada etapa',
      primary: 'Primaria', primaryText: 'Formación integral bilingüe con atención personalizada, pensamiento crítico, valores y convivencia escolar.',
      secondary: 'Secundaria', secondaryText: 'Desarrollo de competencias globales y preparación preuniversitaria con proyección internacional.',
      pathwayTitle: 'Todo lo que necesitas saber', pathwayIntro: 'Explora cada apartado a tu ritmo. Cuando estés listo, completa la ficha de admisión al final de esta página.',
      pathway: ['Conoce las etapas, evaluaciones y documentos requeridos.', 'Revisa las tarifas, beneficios y vencimientos de 2027.', 'Consulta las vacantes limitadas para el grado de interés.'],
      formEyebrow: 'SIGUIENTE PASO', formTitle: 'Comienza tu solicitud', formText: 'Completa la ficha de admisión y nuestro equipo se pondrá en contacto contigo.',
    },
    process: {
      eyebrow: 'UN PROCESO CLARO', title: 'Cómo postular',
      intro: 'El proceso de admisión comprende cuatro etapas, desde la solicitud de información hasta la formalización de la vacante. Nuestro equipo orienta a las familias de Primaria y Secundaria durante cada paso.',
      steps: [
        { title: 'Solicitud de información e inscripción', text: 'Solicita la Constancia de Vacante y completa la ficha de postulación mediante Secretaría o los canales virtuales autorizados, incluido el WhatsApp institucional. Recibirás de manera física o virtual la información económica, las condiciones del servicio y una copia del Reglamento Interno.' },
        { title: 'Presentación de requisitos y documentación', text: 'Entrega los documentos requeridos para la postulación. En los traslados, el certificado de buena conducta es obligatorio. La lista completa figura a continuación.' },
        { title: 'Evaluación de ingreso y orientación', text: 'Al inicio del proceso, el diagnóstico de ingreso identifica las competencias académicas y lingüísticas del estudiante en inglés y francés. Psicología y el Comité de Tutoría brindan orientación socioemocional y evalúan su adaptación escolar.' },
        { title: 'Resultados y formalización', text: 'La Dirección verifica los requisitos y aprueba la admisión conforme a la R.M. N.º 447-2020-MINEDU. La familia recibe la comunicación de la asignación formal de vacante y firma el compromiso de admisión y la matrícula correspondiente.' },
      ],
      tabsTitle: 'Orientación por nivel', primary: 'Primaria', secondary: 'Secundaria',
      primaryText: 'Las familias de Primaria reciben orientación sobre la ficha de postulación, los documentos, la evaluación de competencias y la formalización de la vacante.',
      secondaryText: 'Las familias de Secundaria reciben orientación sobre los mismos pasos, incluida la evaluación académica y lingüística y la documentación de traslado cuando corresponda.',
      transfersTitle: 'Documentación requerida', transfersIntro: 'Los postulantes, especialmente quienes se trasladan desde otra institución, deben presentar:',
      requirements: ['Ficha de Matrícula actualizada.', 'Copia de la Partida o Acta de Nacimiento.', 'Certificados Oficiales de Estudios de los grados concluidos.', 'Libreta de Notas o Informe de Progreso con los resultados alcanzados hasta el traslado.', 'Certificado de Buena Conducta, obligatorio para traslados.', 'Constancia de No Adeudo o verificación de no registrar deudas en la institución de origen.'],
      requirementsNote: 'La documentación se revisa antes de la aprobación de la Dirección y la asignación formal de la vacante.',
    },
    fees: {
      eyebrow: 'INFORMACIÓN ECONÓMICA', title: 'Pensiones escolares',
      intro: 'El servicio educativo se abona en diez pensiones mensuales, de marzo a diciembre. Revisa el tarifario 2026 como referencia histórica y las condiciones para estudiantes nuevos y continuadores en 2027.',
      cards: [
        { title: 'Cuota de ingreso', text: 'Pago único por estudiante al momento de ingresar a la institución.' },
        { title: 'Derecho de matrícula', text: 'Asegura la reserva de la vacante y la inscripción formal para el año lectivo.' },
        { title: 'Pensión mensual', text: 'El costo anual de enseñanza se abona en diez cuotas, de marzo a diciembre.' },
      ],
      plans: {
        historical2026: { title: 'Tarifario 2026', note: 'Referencia histórica de los importes del año escolar 2026.' },
        new2027: { title: 'Estudiantes nuevos 2027', note: 'Primera admisión al colegio en el año escolar 2027.' },
        continuing2027: { title: 'Estudiantes 2026 que continúan en 2027', note: 'Para familias que ratifican su vacante: matrícula con 50 % de descuento y pensión mensual preferencial.' },
      },
      plansTitle: 'Tarifas por año y condición',
      concept: 'Concepto', amount: 'Importe', entry: 'Cuota de ingreso · pago único', enrollment: 'Matrícula', monthly: 'Pensión mensual · 10 cuotas',
      alreadyPaid: 'No se cobra de nuevo si ya fue abonada',
      conditionsTitle: 'Beneficios y condiciones',
      conditions: [
        'El segundo hermano recibe un descuento del 30 % en la pensión, aplicado sobre el hermano mayor o de mayor grado y condicionado al pago puntual del recibo.',
        'Los padres o apoderados con deudas pendientes con la institución no podrán matricular al estudiante para el siguiente año lectivo.',
        'Desde 2027 no se aplica el beneficio adicional por pago puntual para los alumnos que continúan.',
      ],
      scheduleTitle: 'Cronograma de pensiones 2027', scheduleIntro: 'Las diez pensiones vencen en las siguientes fechas:', month: 'Mes', dueDate: 'Vencimiento',
      months: ['Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'],
    },
    vacancies: {
      eyebrow: 'INGRESO 2027', title: 'Vacantes disponibles',
      intro: 'Las vacantes para Primaria y Secundaria son muy limitadas por sección para garantizar una atención personalizada y de calidad. Consulta con Admisiones la disponibilidad del grado de interés antes de iniciar tu solicitud.',
      tabsTitle: 'Consulta por nivel', primary: 'Primaria', secondary: 'Secundaria', grade: 'Grado', availability: 'Disponibilidad', onRequest: 'Consultar disponibilidad',
      primaryGrades: ['1.º Primaria', '2.º Primaria', '3.º Primaria', '4.º Primaria', '5.º Primaria', '6.º Primaria'],
      secondaryGrades: ['1.º Secundaria', '2.º Secundaria', '3.º Secundaria', '4.º Secundaria', '5.º Secundaria'],
      noteTitle: 'Disponibilidad sujeta a confirmación', note: 'Esta página no declara vacantes confirmadas. Nuestro equipo verificará la disponibilidad para el grado que necesitas.',
    },
    ctaTitle: 'Estamos aquí para acompañarte', ctaText: 'Cuéntanos qué grado te interesa y te orientaremos sobre el siguiente paso.',
  },
  en: {
    home: 'Home', admission: 'Admissions 2027', sideTitle: 'Explore admissions',
    nav: { overview: 'New student admissions', process: 'How to apply', fees: 'School fees', vacancies: 'Available places' },
    sideHelp: 'Need guidance?', sideHelpText: 'Our team can answer your questions before you apply.', sideHelpLink: 'Contact Admissions',
    apply: 'Start an application', consult: 'Ask Admissions', more: 'Explore the process',
    overview: {
      eyebrow: 'YOUR JOURNEY STARTS HERE', title: 'A place to grow, learn and discover.',
      intro: 'Boston Bilingual School welcomes families in Trujillo seeking excellent bilingual education, well-rounded development and international pre-university preparation for their children in Primary and Secondary School.',
      detail: 'Our inclusive learning environment fosters critical thinking, values and global competencies alongside positive school relationships. Places are very limited in each class so that every student receives personalized, high-quality attention, in accordance with Ministry of Education regulations and the school’s Internal Regulations.',
      processText: 'To begin, complete the admissions application and submit the required documents, including previous academic records and, for transfers, a Certificate of Good Conduct. We assess and guide each applicant as they join our curriculum and language immersion program. Once requirements are reviewed, we communicate the result and the family formalizes the place by signing the admissions commitment and completing enrollment.',
      imageAlt: 'Admissions advisor speaking with a family', imageLabel: 'A community by your side',
      levelsTitle: 'Learning for every stage',
      primary: 'Primary', primaryText: 'Well-rounded bilingual education with personalized attention, critical thinking, values and positive school relationships.',
      secondary: 'Secondary', secondaryText: 'Development of global competencies and pre-university preparation with an international outlook.',
      pathwayTitle: 'Everything you need to know', pathwayIntro: 'Explore each section at your own pace. When you are ready, complete the admissions form at the end of this page.',
      pathway: ['Review the stages, assessments and required documents.', 'See 2027 fees, benefits and payment due dates.', 'Ask about the limited places in the grade you need.'],
      formEyebrow: 'NEXT STEP', formTitle: 'Begin your application', formText: 'Complete the admissions form and our team will get in touch.',
    },
    process: {
      eyebrow: 'A CLEAR PATH', title: 'How to apply',
      intro: 'The admissions process has four stages, from requesting information to formalizing a place. Our team guides Primary and Secondary families through every step.',
      steps: [
        { title: 'Information request and registration', text: 'Request the Constancia de Vacante (vacancy certificate) and complete the application form through the school office or authorized virtual channels, including the school’s WhatsApp. You will receive the financial information, service terms and a copy of the Internal Regulations, in print or digitally.' },
        { title: 'Requirements and documents', text: 'Submit the documents required for admission. For transfers, a Certificate of Good Conduct is mandatory. The full list appears below.' },
        { title: 'Entrance assessment and guidance', text: 'At the start of the process, the entrance assessment identifies the student’s academic and language competencies in English and French. Psychology staff and the Tutoring Committee provide social and emotional guidance and assess school adjustment.' },
        { title: 'Results and formalization', text: 'School leadership verifies the requirements and approves admission under R.M. No. 447-2020-MINEDU. The family is notified of the formal allocation of a place, then signs the admissions commitment and completes enrollment.' },
      ],
      tabsTitle: 'Guidance by level', primary: 'Primary', secondary: 'Secondary',
      primaryText: 'Primary families receive guidance on the application form, required documents, competency assessment and formal allocation of a place.',
      secondaryText: 'Secondary families receive guidance on the same stages, including the academic and language assessment and transfer documents where applicable.',
      transfersTitle: 'Required documents', transfersIntro: 'Applicants, especially those transferring from another school, must submit:',
      requirements: ['Updated Enrollment Form.', 'Copy of the applicant’s Birth Certificate or Birth Record.', 'Official Study Certificates for completed grades.', 'Report Card or Progress Report showing results up to the date of transfer.', 'Certificate of Good Conduct, mandatory for transfers.', 'No Outstanding Debt Certificate or verification that no debt is owed to the previous school.'],
      requirementsNote: 'The documents are reviewed before school leadership approves admission and formally allocates a place.',
    },
    fees: {
      eyebrow: 'FINANCIAL INFORMATION', title: 'School fees',
      intro: 'The educational service is paid in ten monthly installments from March to December. Review the 2026 fees as a historical reference and the 2027 terms for new and continuing students.',
      cards: [
        { title: 'Entrance fee', text: 'A one-time payment per student when they first join the school.' },
        { title: 'Enrollment fee', text: 'Reserves the place and formalizes registration for the school year.' },
        { title: 'Monthly tuition', text: 'The annual cost of education is paid in ten installments, from March to December.' },
      ],
      plans: {
        historical2026: { title: '2026 fee schedule', note: 'Historical reference for the 2026 school year.' },
        new2027: { title: 'New students in 2027', note: 'Students joining the school for the first time in 2027.' },
        continuing2027: { title: '2026 students continuing in 2027', note: 'For families confirming their place: a 50% enrollment discount and a preferential monthly tuition rate.' },
      },
      plansTitle: 'Fees by year and student status',
      concept: 'Item', amount: 'Amount', entry: 'Entrance fee · one-time payment', enrollment: 'Enrollment', monthly: 'Monthly tuition · 10 installments',
      alreadyPaid: 'Not charged again if already paid',
      conditionsTitle: 'Benefits and conditions',
      conditions: [
        'The second sibling receives a 30% discount on tuition, applied to the older sibling or the one in a higher grade, provided the bill is paid on time.',
        'Parents or guardians with outstanding debt to the school cannot enroll the student for the following school year.',
        'From 2027, the additional early-payment benefit no longer applies to continuing students.',
      ],
      scheduleTitle: '2027 tuition payment schedule', scheduleIntro: 'The ten installments fall due on these dates:', month: 'Month', dueDate: 'Due date',
      months: ['March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'],
    },
    vacancies: {
      eyebrow: '2027 ENTRY', title: 'Available places',
      intro: 'Places in Primary and Secondary are very limited in each class to ensure personalized, high-quality attention. Contact Admissions to check availability for your chosen grade before applying.',
      tabsTitle: 'Check by level', primary: 'Primary', secondary: 'Secondary', grade: 'Grade', availability: 'Availability', onRequest: 'Check availability',
      primaryGrades: ['Primary 1', 'Primary 2', 'Primary 3', 'Primary 4', 'Primary 5', 'Primary 6'],
      secondaryGrades: ['Secondary 1', 'Secondary 2', 'Secondary 3', 'Secondary 4', 'Secondary 5'],
      noteTitle: 'Availability requires confirmation', note: 'This page does not state that places are confirmed. Our team will check availability for the grade you need.',
    },
    ctaTitle: 'We are here to help', ctaText: 'Tell us which grade you are interested in and we will guide you through the next step.',
  },
} as const;
const t = copy[lang];
const navItems: Section[] = ['overview', 'process', 'fees', 'vacancies'];
const current = t[section];
---

<svg class="admission-symbols" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <symbol id="admission-arrow" viewBox="0 0 24 24"><path d="M5 12h14m-6-6 6 6-6 6"/></symbol>
  <symbol id="admission-book" viewBox="0 0 24 24"><path d="M12 5c-2-2-5-2-9-2v15c4 0 7 0 9 2 2-2 5-2 9-2V3c-4 0-7 0-9 2Zm0 0v15"/></symbol>
  <symbol id="admission-cap" viewBox="0 0 24 24"><path d="m2 9 10-5 10 5-10 5L2 9Zm4 3v5c3 3 9 3 12 0v-5m4-3v7"/></symbol>
  <symbol id="admission-check" viewBox="0 0 24 24"><path d="m4 12 5 5L20 6"/></symbol>
</svg>

<section class:list={['admission-shell', { 'admission-shell--interior': section !== 'overview', 'admission-shell--fees': section === 'fees' }]}>
  <div class="container admission-shell__grid">
    <aside class="admission-side" aria-label={t.sideTitle}>
      <div class="admission-side__heading"><span class="admission-side__mark"></span><span>{t.admission}</span></div>
      <nav class="admission-nav" aria-label={t.sideTitle}>
        {navItems.map((item, index) => (
          <a href={routes[item]} class:list={['admission-nav__link', { 'is-active': section === item }]} aria-current={section === item ? 'page' : undefined}>
            <span class="admission-nav__number">0{index + 1}</span><span>{t.nav[item]}</span>
            <svg aria-hidden="true"><use href="#admission-arrow" /></svg>
          </a>
        ))}
      </nav>
      <div class="admission-side__help">
        <span class="admission-side__help-icon">?</span>
        <strong>{t.sideHelp}</strong>
        <p>{t.sideHelpText}</p>
        <a href={`/${lang}/contacto/`}>{t.sideHelpLink}<span aria-hidden="true">↗</span></a>
      </div>
    </aside>

    <div class="admission-main">
      <nav class="admission-breadcrumb" aria-label={lang === 'es' ? 'Ruta de navegación' : 'Breadcrumb'}>
        <a href={`/${lang}/`}>{t.home}</a><span aria-hidden="true">/</span>
        {section === 'overview' ? <span aria-current="page">{t.admission}</span> : <><a href={base}>{t.admission}</a><span aria-hidden="true">/</span><span aria-current="page">{t.nav[section]}</span></>}
      </nav>

      {section === 'overview' && <>
        <div class="admission-heading admission-heading--overview">
          <span class="admission-eyebrow">{t.overview.eyebrow}</span>
          <h2>{t.overview.title}</h2>
          <p>{t.overview.intro}</p>
          <p>{t.overview.detail}</p>
          <p>{t.overview.processText}</p>
          <a class="admission-button" href={applyHref}>{t.apply}<svg aria-hidden="true"><use href="#admission-arrow" /></svg></a>
        </div>
        <figure class="admission-feature-photo">
          <img src="/images/admisiones/admisiones-entrevista.webp" alt={t.overview.imageAlt} width="900" height="600" loading="lazy" decoding="async" />
          <figcaption><span></span>{t.overview.imageLabel}</figcaption>
        </figure>
        <section class="admission-block" aria-labelledby="levels-title">
          <div class="admission-section-label"><span>01</span><h3 id="levels-title">{t.overview.levelsTitle}</h3></div>
          <div class="admission-levels">
            <article class="admission-level"><div class="admission-level__icon"><svg aria-hidden="true"><use href="#admission-book" /></svg></div><div><h4>{t.overview.primary}</h4><p>{t.overview.primaryText}</p></div></article>
            <article class="admission-level"><div class="admission-level__icon"><svg aria-hidden="true"><use href="#admission-cap" /></svg></div><div><h4>{t.overview.secondary}</h4><p>{t.overview.secondaryText}</p></div></article>
          </div>
        </section>
        <section class="admission-block" aria-labelledby="pathway-title">
          <div class="admission-section-label"><span>02</span><h3 id="pathway-title">{t.overview.pathwayTitle}</h3></div>
          <p class="admission-block__intro">{t.overview.pathwayIntro}</p>
          <div class="admission-pathway">
            {(['process', 'fees', 'vacancies'] as const).map((item, index) => (
              <a href={routes[item]} class="admission-pathway__card"><span>0{index + 1}</span><h4>{t.nav[item]}</h4><p>{t.overview.pathway[index]}</p><svg aria-hidden="true"><use href="#admission-arrow" /></svg></a>
            ))}
          </div>
        </section>
        <section id="postulacion" class="admission-form-section" aria-labelledby="form-title">
          <div class="admission-form-section__heading"><span class="admission-eyebrow">{t.overview.formEyebrow}</span><h3 id="form-title">{t.overview.formTitle}</h3><p>{t.overview.formText}</p></div>
          <AdmissionsFormSimple lang={lang} variant="landing" />
        </section>
      </>}

      {section !== 'overview' && <>
        <div class="admission-heading admission-heading--interior">
          <span class="admission-eyebrow">{current.eyebrow}</span>
          <h1>{current.title}</h1>
          <p>{current.intro}</p>
        </div>

        {section === 'process' && <>
          <section class="admission-block" aria-label={t.process.title}>
            <div class="admission-steps">
              {t.process.steps.map((step, index) => (
                <article class="admission-step"><span class="admission-step__number">0{index + 1}</span><div class="admission-step__line"></div><h2>{step.title}</h2><p>{step.text}</p></article>
              ))}
            </div>
          </section>
          <section class="admission-block" aria-labelledby="process-levels-title">
            <div class="admission-section-label"><span>01</span><h2 id="process-levels-title">{t.process.tabsTitle}</h2></div>
            <div class="admission-tabs" data-admission-tabs>
              <div class="admission-tabs__list" role="tablist" aria-label={t.process.tabsTitle}>
                <button type="button" role="tab" id="process-primary-tab" aria-controls="process-primary" aria-selected="true" tabindex="0">{t.process.primary}</button>
                <button type="button" role="tab" id="process-secondary-tab" aria-controls="process-secondary" aria-selected="false" tabindex="-1">{t.process.secondary}</button>
              </div>
              <div class="admission-tabs__panel" role="tabpanel" id="process-primary" aria-labelledby="process-primary-tab"><div class="admission-tabs__icon"><svg aria-hidden="true"><use href="#admission-book" /></svg></div><p>{t.process.primaryText}</p></div>
              <div class="admission-tabs__panel" role="tabpanel" id="process-secondary" aria-labelledby="process-secondary-tab" hidden><div class="admission-tabs__icon"><svg aria-hidden="true"><use href="#admission-cap" /></svg></div><p>{t.process.secondaryText}</p></div>
            </div>
          </section>
          <section class="admission-block admission-transfer" aria-labelledby="transfer-title">
            <div class="admission-section-label"><span>02</span><h2 id="transfer-title">{t.process.transfersTitle}</h2></div>
            <p>{t.process.transfersIntro}</p>
            <ul>{t.process.requirements.map((requirement) => <li><svg aria-hidden="true"><use href="#admission-check" /></svg>{requirement}</li>)}</ul>
            <p class="admission-note">{t.process.requirementsNote}</p>
          </section>
        </>}

        {section === 'fees' && <>
          <section class="admission-block" aria-label={t.fees.title}>
            <div class="admission-info-grid">
              {t.fees.cards.map((card, index) => <article class="admission-info-card"><span>0{index + 1}</span><h2>{card.title}</h2><p>{card.text}</p></article>)}
            </div>
          </section>
          <section class="admission-block" aria-labelledby="fees-plans-title">
            <div class="admission-section-label"><span>01</span><h2 id="fees-plans-title">{t.fees.plansTitle}</h2></div>
            <div class="admission-fee-plans">
              {feePlanOrder.map((planKey) => <article class="admission-fee-plan">
                <div class="admission-fee-plan__heading"><h3>{t.fees.plans[planKey].title}</h3><p>{t.fees.plans[planKey].note}</p></div>
                <div class="admission-table-wrap"><table>
                  <thead><tr><th scope="col">{t.fees.concept}</th><th scope="col">{t.fees.amount}</th></tr></thead>
                  <tbody>
                    <tr><th scope="row">{t.fees.entry}</th><td>{feePlans[planKey].entry === null ? t.fees.alreadyPaid : soles(feePlans[planKey].entry)}</td></tr>
                    <tr><th scope="row">{t.fees.enrollment}</th><td>{soles(feePlans[planKey].enrollment)}</td></tr>
                    <tr><th scope="row">{t.fees.monthly}</th><td>{soles(feePlans[planKey].monthly)}</td></tr>
                  </tbody>
                </table></div>
              </article>)}
            </div>
          </section>
          <section class="admission-block admission-highlight" aria-labelledby="conditions-title"><div class="admission-highlight__icon"><svg aria-hidden="true"><use href="#admission-check" /></svg></div><div><h2 id="conditions-title">{t.fees.conditionsTitle}</h2><ul>{t.fees.conditions.map((condition) => <li>{condition}</li>)}</ul></div></section>
          <section class="admission-block" aria-labelledby="fee-schedule-title">
            <div class="admission-section-label"><span>02</span><h2 id="fee-schedule-title">{t.fees.scheduleTitle}</h2></div>
            <p class="admission-block__intro">{t.fees.scheduleIntro}</p>
            <div class="admission-table-wrap admission-schedule-table"><table>
              <thead><tr><th scope="col">{t.fees.month}</th><th scope="col">{t.fees.dueDate}</th></tr></thead>
              <tbody>{pensionDueDates.map((date, index) => <tr><th scope="row">{t.fees.months[index]}</th><td>{date}</td></tr>)}</tbody>
            </table></div>
          </section>
        </>}

        {section === 'vacancies' && <>
          <section class="admission-block" aria-labelledby="vacancies-table-title">
            <div class="admission-section-label"><span>01</span><h2 id="vacancies-table-title">{t.vacancies.tabsTitle}</h2></div>
            <div class="admission-tabs" data-admission-tabs>
              <div class="admission-tabs__list" role="tablist" aria-label={t.vacancies.tabsTitle}>
                <button type="button" role="tab" id="vacancies-primary-tab" aria-controls="vacancies-primary" aria-selected="true" tabindex="0">{t.vacancies.primary}</button>
                <button type="button" role="tab" id="vacancies-secondary-tab" aria-controls="vacancies-secondary" aria-selected="false" tabindex="-1">{t.vacancies.secondary}</button>
              </div>
              <div class="admission-tabs__panel admission-tabs__panel--table" role="tabpanel" id="vacancies-primary" aria-labelledby="vacancies-primary-tab"><div class="admission-table-wrap"><table><thead><tr><th scope="col">{t.vacancies.grade}</th><th scope="col">{t.vacancies.availability}</th></tr></thead><tbody>{t.vacancies.primaryGrades.map((grade) => <tr><th scope="row">{grade}</th><td>{t.vacancies.onRequest}</td></tr>)}</tbody></table></div></div>
              <div class="admission-tabs__panel admission-tabs__panel--table" role="tabpanel" id="vacancies-secondary" aria-labelledby="vacancies-secondary-tab" hidden><div class="admission-table-wrap"><table><thead><tr><th scope="col">{t.vacancies.grade}</th><th scope="col">{t.vacancies.availability}</th></tr></thead><tbody>{t.vacancies.secondaryGrades.map((grade) => <tr><th scope="row">{grade}</th><td>{t.vacancies.onRequest}</td></tr>)}</tbody></table></div></div>
            </div>
          </section>
          <section class="admission-block admission-highlight" aria-labelledby="vacancies-note-title"><div class="admission-highlight__icon"><svg aria-hidden="true"><use href="#admission-check" /></svg></div><div><h2 id="vacancies-note-title">{t.vacancies.noteTitle}</h2><p>{t.vacancies.note}</p></div></section>
        </>}

        <section class="admission-cta" aria-label={t.ctaTitle}>
          <div><span class="admission-eyebrow">{t.admission}</span><h2>{t.ctaTitle}</h2><p>{t.ctaText}</p></div>
          <a class="admission-button admission-button--light" href={applyHref}>{t.apply}<svg aria-hidden="true"><use href="#admission-arrow" /></svg></a>
        </section>
      </>}
    </div>
  </div>
</section>

<script>
  const initAdmissionControls = () => {
    if (!document.querySelector('.admission-shell')) return;

    document.querySelectorAll<HTMLElement>('[data-admission-tabs]').forEach((tabs) => {
      if (tabs.dataset.initialized) return;
      tabs.dataset.initialized = 'true';
      const buttons = Array.from(tabs.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
      const select = (chosen: HTMLButtonElement) => {
        buttons.forEach((button) => {
          const active = button === chosen;
          button.setAttribute('aria-selected', String(active));
          button.tabIndex = active ? 0 : -1;
          const panel = document.getElementById(button.getAttribute('aria-controls') || '');
          if (panel) panel.hidden = !active;
        });
      };
      buttons.forEach((button, index) => {
        button.addEventListener('click', () => select(button));
        button.addEventListener('keydown', (event) => {
          if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
          event.preventDefault();
          const next = buttons[(index + (event.key === 'ArrowRight' ? 1 : -1) + buttons.length) % buttons.length];
          select(next);
          next.focus();
        });
      });
    });

    const admissionsPrefix = location.pathname.match(/^\/(es|en)\/admisiones\//)?.[0];
    if (!admissionsPrefix) return;
    document.querySelectorAll<HTMLAnchorElement>('a[href]').forEach((link) => {
      const target = new URL(link.href);
      if (target.origin === location.origin && !target.pathname.startsWith(admissionsPrefix)) {
        link.setAttribute('data-astro-reload', '');
      }
    });
  };

  let admissionScroll: { y: number; navX: number } | null = null;
  document.addEventListener('astro:before-preparation', (event) => {
    const next = (event as Event & { to?: URL }).to;
    const fromLang = location.pathname.match(/^\/(es|en)\/admisiones\//)?.[1];
    const toLang = next?.pathname.match(/^\/(es|en)\/admisiones\//)?.[1];
    admissionScroll = fromLang && fromLang === toLang && !next?.hash
      ? { y: window.scrollY, navX: document.querySelector<HTMLElement>('.admission-nav')?.scrollLeft ?? 0 }
      : null;
  });
  document.addEventListener('astro:after-swap', () => {
    if (!admissionScroll) return;
    window.scrollTo({ top: admissionScroll.y, behavior: 'instant' });
    const nav = document.querySelector<HTMLElement>('.admission-nav');
    if (nav) nav.scrollLeft = admissionScroll.navX;
    admissionScroll = null;
  });

  document.addEventListener('astro:page-load', initAdmissionControls);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAdmissionControls, { once: true });
  } else {
    initAdmissionControls();
  }
</script>

