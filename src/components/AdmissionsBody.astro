---
import AdmissionsFormSimple from './AdmissionsFormSimple.astro';

type Section = 'overview' | 'process' | 'fees' | 'vacancies';
interface Props { lang: 'es' | 'en'; section?: Section }
const { lang, section = 'overview' } = Astro.props;
const base = `/${lang}/admisiones/`;
const applyHref = `${base}#postulacion`;
const routes: Record<Section, string> = {
  overview: base,
  process: `${base}como-postular/`,
  fees: `${base}pensiones/`,
  vacancies: `${base}vacantes/`,
};

const copy = {
  es: {
    home: 'Inicio', admission: 'Admisión 2027', sideTitle: 'Explora admisiones',
    nav: { overview: 'Admisión de nuevos estudiantes', process: 'Cómo postular', fees: 'Pensiones escolares', vacancies: 'Vacantes disponibles' },
    sideHelp: '¿Necesitas orientación?', sideHelpText: 'Nuestro equipo puede ayudarte a resolver tus dudas antes de postular.', sideHelpLink: 'Contactar a Admisiones',
    apply: 'Solicitar admisión', consult: 'Consultar con Admisiones', more: 'Conoce el proceso',
    overview: {
      eyebrow: 'TU CAMINO COMIENZA AQUÍ', title: 'Un lugar para crecer, aprender y descubrir.',
      intro: 'En Boston Bilingual School acompañamos a cada familia con cercanía y claridad durante el proceso de admisión 2027. Conoce nuestra propuesta para Primaria y Secundaria y encuentra el siguiente paso para tu familia.',
      imageAlt: 'Asesora de admisiones conversando con una familia', imageLabel: 'Una comunidad que acompaña',
      levelsTitle: 'Una formación para cada etapa',
      primary: 'Primaria', primaryText: 'Una base bilingüe y una formación integral que despiertan la curiosidad y el gusto por aprender.',
      secondary: 'Secundaria', secondaryText: 'Acompañamiento académico y experiencias que preparan a los estudiantes para sus próximos desafíos.',
      pathwayTitle: 'Todo lo que necesitas saber', pathwayIntro: 'Explora cada apartado a tu ritmo. Cuando estés listo, completa la ficha de admisión al final de esta página.',
      pathway: ['Conoce las etapas y los requisitos del proceso.', 'Consulta la información económica directamente con el colegio.', 'Pregunta por la disponibilidad para el grado de interés.'],
      formEyebrow: 'SIGUIENTE PASO', formTitle: 'Comienza tu solicitud', formText: 'Completa la ficha de admisión y nuestro equipo se pondrá en contacto contigo.',
    },
    process: {
      eyebrow: 'UN PROCESO CLARO', title: 'Cómo postular',
      intro: 'Te acompañamos en cada etapa del proceso. La entrevista o evaluación se realiza según corresponda al grado solicitado.',
      steps: [
        { title: 'Solicitud de información', text: 'Completa la ficha de admisión para que nuestro equipo conozca tu interés y pueda orientarte.' },
        { title: 'Entrevista o evaluación', text: 'Conversamos con la familia y, si corresponde, realizamos una evaluación de admisión.' },
        { title: 'Documentación', text: 'Presenta los requisitos necesarios para continuar el proceso de ingreso.' },
        { title: 'Matrícula', text: 'Completa la matrícula y la firma del contrato de servicio educativo.' },
      ],
      tabsTitle: 'Orientación por nivel', primary: 'Primaria', secondary: 'Secundaria',
      primaryText: 'Nuestro equipo orienta a las familias de Primaria sobre la solicitud, la entrevista o evaluación que corresponda y los documentos necesarios.',
      secondaryText: 'Para Secundaria, el equipo de admisiones explica las etapas aplicables al grado solicitado y acompaña a la familia hasta la matrícula.',
      transfersTitle: 'Documentación para traslados', transfersIntro: 'Entre los requisitos existentes para traslados se encuentran:',
      requirements: ['Libreta de notas', 'Foto del DNI del estudiante', 'Foto del DNI de ambos padres', 'Constancia de no adeudo del colegio de procedencia'],
      requirementsNote: 'Confirma con Admisiones la documentación aplicable a tu caso antes de presentarla.',
    },
    fees: {
      eyebrow: 'INFORMACIÓN ECONÓMICA', title: 'Pensiones escolares',
      intro: 'La información sobre matrícula, pensiones, cronogramas y condiciones de pago se confirma directamente con Admisiones. Te orientaremos según el nivel y el grado de interés.',
      cards: [
        { title: 'Matrícula', text: 'Consulta el importe y las condiciones vigentes para formalizar el ingreso.' },
        { title: 'Pensiones', text: 'Solicita la información de pensiones correspondiente al nivel de interés.' },
        { title: 'Cronograma', text: 'Pide el calendario vigente de pagos y sus fechas aplicables.' },
      ],
      tableTitle: 'Consulta por nivel', level: 'Nivel', tuition: 'Matrícula', pension: 'Pensión',
      primary: 'Primaria', secondary: 'Secundaria', onRequest: 'Información previa consulta',
      conditionsTitle: 'Condiciones de pago', conditionsText: 'El equipo de Admisiones te proporcionará las condiciones y el cronograma vigentes antes de completar la matrícula.',
      note: 'No se muestran importes sin confirmación oficial del colegio.',
    },
    vacancies: {
      eyebrow: 'INGRESO 2027', title: 'Vacantes disponibles',
      intro: 'La disponibilidad puede variar por nivel y grado. Consulta con Admisiones para recibir información actualizada antes de iniciar tu solicitud.',
      tabsTitle: 'Consulta por nivel', primary: 'Primaria', secondary: 'Secundaria', grade: 'Grado', availability: 'Disponibilidad', onRequest: 'Consultar disponibilidad',
      primaryGrades: ['1.º Primaria', '2.º Primaria', '3.º Primaria', '4.º Primaria', '5.º Primaria', '6.º Primaria'],
      secondaryGrades: ['1.º Secundaria', '2.º Secundaria', '3.º Secundaria', '4.º Secundaria', '5.º Secundaria'],
      noteTitle: 'Disponibilidad sujeta a confirmación', note: 'Esta página no declara vacantes confirmadas. Nuestro equipo verificará la disponibilidad para el grado que necesitas.',
    },
    ctaTitle: 'Estamos aquí para acompañarte', ctaText: 'Cuéntanos qué grado te interesa y te orientaremos sobre el siguiente paso.',
  },
  en: {
    home: 'Home', admission: 'Admissions 2027', sideTitle: 'Explore admissions',
    nav: { overview: 'New student admissions', process: 'How to apply', fees: 'School fees', vacancies: 'Available places' },
    sideHelp: 'Need guidance?', sideHelpText: 'Our team can answer your questions before you apply.', sideHelpLink: 'Contact Admissions',
    apply: 'Start an application', consult: 'Ask Admissions', more: 'Explore the process',
    overview: {
      eyebrow: 'YOUR JOURNEY STARTS HERE', title: 'A place to grow, learn and discover.',
      intro: 'At Boston Bilingual School, we guide each family through the 2027 admissions process with care and clarity. Explore our Primary and Secondary programs and find the next step for your family.',
      imageAlt: 'Admissions advisor speaking with a family', imageLabel: 'A community by your side',
      levelsTitle: 'Learning for every stage',
      primary: 'Primary', primaryText: 'A bilingual foundation and well-rounded education that spark curiosity and a love of learning.',
      secondary: 'Secondary', secondaryText: 'Academic guidance and experiences that prepare students for the challenges ahead.',
      pathwayTitle: 'Everything you need to know', pathwayIntro: 'Explore each section at your own pace. When you are ready, complete the admissions form at the end of this page.',
      pathway: ['Review the steps and requirements.', 'Ask the school directly for financial information.', 'Check availability for the grade you need.'],
      formEyebrow: 'NEXT STEP', formTitle: 'Begin your application', formText: 'Complete the admissions form and our team will get in touch.',
    },
    process: {
      eyebrow: 'A CLEAR PATH', title: 'How to apply',
      intro: 'We guide you through every stage. An interview or assessment takes place when applicable to the requested grade.',
      steps: [
        { title: 'Request information', text: 'Complete the admissions form so our team can learn about your interest and guide you.' },
        { title: 'Interview or assessment', text: 'We speak with the family and, when applicable, conduct an admissions assessment.' },
        { title: 'Documentation', text: 'Submit the requirements needed to continue the admissions process.' },
        { title: 'Enrollment', text: 'Complete enrollment and sign the educational services agreement.' },
      ],
      tabsTitle: 'Guidance by level', primary: 'Primary', secondary: 'Secondary',
      primaryText: 'Our team guides Primary families through the application, the interview or assessment where applicable, and the required documents.',
      secondaryText: 'For Secondary, the admissions team explains the stages for the requested grade and supports the family through enrollment.',
      transfersTitle: 'Transfer documentation', transfersIntro: 'Existing transfer requirements include:',
      requirements: ['Report card', "Photo of the student's DNI", "Photos of both parents' DNI documents", 'Certificate of no outstanding debt from the previous school'],
      requirementsNote: 'Confirm which documents apply to your case with Admissions before submitting them.',
    },
    fees: {
      eyebrow: 'FINANCIAL INFORMATION', title: 'School fees',
      intro: 'Enrollment costs, school fees, payment schedules and terms are confirmed directly with Admissions. We will guide you according to the level and grade you are interested in.',
      cards: [
        { title: 'Enrollment', text: 'Ask about the current amount and terms for formalizing enrollment.' },
        { title: 'School fees', text: 'Request fee information for the level you are interested in.' },
        { title: 'Schedule', text: 'Ask for the current payment calendar and applicable dates.' },
      ],
      tableTitle: 'Information by level', level: 'Level', tuition: 'Enrollment', pension: 'School fees',
      primary: 'Primary', secondary: 'Secondary', onRequest: 'Information upon request',
      conditionsTitle: 'Payment terms', conditionsText: 'The Admissions team will provide the current terms and payment schedule before enrollment is completed.',
      note: 'Amounts are not shown without official confirmation from the school.',
    },
    vacancies: {
      eyebrow: '2027 ENTRY', title: 'Available places',
      intro: 'Availability may vary by level and grade. Contact Admissions for up-to-date information before starting your application.',
      tabsTitle: 'Check by level', primary: 'Primary', secondary: 'Secondary', grade: 'Grade', availability: 'Availability', onRequest: 'Check availability',
      primaryGrades: ['Primary 1', 'Primary 2', 'Primary 3', 'Primary 4', 'Primary 5', 'Primary 6'],
      secondaryGrades: ['Secondary 1', 'Secondary 2', 'Secondary 3', 'Secondary 4', 'Secondary 5'],
      noteTitle: 'Availability requires confirmation', note: 'This page does not state that places are confirmed. Our team will check availability for the grade you need.',
    },
    ctaTitle: 'We are here to help', ctaText: 'Tell us which grade you are interested in and we will guide you through the next step.',
  },
} as const;
const t = copy[lang];
const navItems: Section[] = ['overview', 'process', 'fees', 'vacancies'];
const current = t[section];
---

<svg class="admission-symbols" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <symbol id="admission-arrow" viewBox="0 0 24 24"><path d="M5 12h14m-6-6 6 6-6 6"/></symbol>
  <symbol id="admission-book" viewBox="0 0 24 24"><path d="M12 5c-2-2-5-2-9-2v15c4 0 7 0 9 2 2-2 5-2 9-2V3c-4 0-7 0-9 2Zm0 0v15"/></symbol>
  <symbol id="admission-cap" viewBox="0 0 24 24"><path d="m2 9 10-5 10 5-10 5L2 9Zm4 3v5c3 3 9 3 12 0v-5m4-3v7"/></symbol>
  <symbol id="admission-check" viewBox="0 0 24 24"><path d="m4 12 5 5L20 6"/></symbol>
</svg>

<section class:list={['admission-shell', { 'admission-shell--interior': section !== 'overview' }]}>
  <div class="container admission-shell__grid">
    <aside class="admission-side" aria-label={t.sideTitle}>
      <div class="admission-side__heading"><span class="admission-side__mark"></span><span>{t.admission}</span></div>
      <nav class="admission-nav" aria-label={t.sideTitle}>
        {navItems.map((item, index) => (
          <a href={routes[item]} class:list={['admission-nav__link', { 'is-active': section === item }]} aria-current={section === item ? 'page' : undefined}>
            <span class="admission-nav__number">0{index + 1}</span><span>{t.nav[item]}</span>
            <svg aria-hidden="true"><use href="#admission-arrow" /></svg>
          </a>
        ))}
      </nav>
      <div class="admission-side__help">
        <span class="admission-side__help-icon">?</span>
        <strong>{t.sideHelp}</strong>
        <p>{t.sideHelpText}</p>
        <a href={`/${lang}/contacto/`}>{t.sideHelpLink}<span aria-hidden="true">↗</span></a>
      </div>
    </aside>

    <div class="admission-main">
      <nav class="admission-breadcrumb" aria-label={lang === 'es' ? 'Ruta de navegación' : 'Breadcrumb'}>
        <a href={`/${lang}/`}>{t.home}</a><span aria-hidden="true">/</span>
        {section === 'overview' ? <span aria-current="page">{t.admission}</span> : <><a href={base}>{t.admission}</a><span aria-hidden="true">/</span><span aria-current="page">{t.nav[section]}</span></>}
      </nav>

      {section === 'overview' && <>
        <div class="admission-heading admission-heading--overview">
          <span class="admission-eyebrow">{t.overview.eyebrow}</span>
          <h2>{t.overview.title}</h2>
          <p>{t.overview.intro}</p>
          <a class="admission-button" href={applyHref}>{t.apply}<svg aria-hidden="true"><use href="#admission-arrow" /></svg></a>
        </div>
        <figure class="admission-feature-photo">
          <img src="/images/admisiones/admisiones-entrevista.webp" alt={t.overview.imageAlt} width="900" height="600" loading="lazy" decoding="async" />
          <figcaption><span></span>{t.overview.imageLabel}</figcaption>
        </figure>
        <section class="admission-block" aria-labelledby="levels-title">
          <div class="admission-section-label"><span>01</span><h3 id="levels-title">{t.overview.levelsTitle}</h3></div>
          <div class="admission-levels">
            <article class="admission-level"><div class="admission-level__icon"><svg aria-hidden="true"><use href="#admission-book" /></svg></div><div><h4>{t.overview.primary}</h4><p>{t.overview.primaryText}</p></div></article>
            <article class="admission-level"><div class="admission-level__icon"><svg aria-hidden="true"><use href="#admission-cap" /></svg></div><div><h4>{t.overview.secondary}</h4><p>{t.overview.secondaryText}</p></div></article>
          </div>
        </section>
        <section class="admission-block" aria-labelledby="pathway-title">
          <div class="admission-section-label"><span>02</span><h3 id="pathway-title">{t.overview.pathwayTitle}</h3></div>
          <p class="admission-block__intro">{t.overview.pathwayIntro}</p>
          <div class="admission-pathway">
            {(['process', 'fees', 'vacancies'] as const).map((item, index) => (
              <a href={routes[item]} class="admission-pathway__card"><span>0{index + 1}</span><h4>{t.nav[item]}</h4><p>{t.overview.pathway[index]}</p><svg aria-hidden="true"><use href="#admission-arrow" /></svg></a>
            ))}
          </div>
        </section>
        <section id="postulacion" class="admission-form-section" aria-labelledby="form-title">
          <div class="admission-form-section__heading"><span class="admission-eyebrow">{t.overview.formEyebrow}</span><h3 id="form-title">{t.overview.formTitle}</h3><p>{t.overview.formText}</p></div>
          <AdmissionsFormSimple lang={lang} variant="landing" />
        </section>
      </>}

      {section !== 'overview' && <>
        <div class="admission-heading admission-heading--interior">
          <span class="admission-eyebrow">{current.eyebrow}</span>
          <h1>{current.title}</h1>
          <p>{current.intro}</p>
        </div>

        {section === 'process' && <>
          <section class="admission-block" aria-label={t.process.title}>
            <div class="admission-steps">
              {t.process.steps.map((step, index) => (
                <article class="admission-step"><span class="admission-step__number">0{index + 1}</span><div class="admission-step__line"></div><h2>{step.title}</h2><p>{step.text}</p></article>
              ))}
            </div>
          </section>
          <section class="admission-block" aria-labelledby="process-levels-title">
            <div class="admission-section-label"><span>01</span><h2 id="process-levels-title">{t.process.tabsTitle}</h2></div>
            <div class="admission-tabs" data-admission-tabs>
              <div class="admission-tabs__list" role="tablist" aria-label={t.process.tabsTitle}>
                <button type="button" role="tab" id="process-primary-tab" aria-controls="process-primary" aria-selected="true" tabindex="0">{t.process.primary}</button>
                <button type="button" role="tab" id="process-secondary-tab" aria-controls="process-secondary" aria-selected="false" tabindex="-1">{t.process.secondary}</button>
              </div>
              <div class="admission-tabs__panel" role="tabpanel" id="process-primary" aria-labelledby="process-primary-tab"><div class="admission-tabs__icon"><svg aria-hidden="true"><use href="#admission-book" /></svg></div><p>{t.process.primaryText}</p></div>
              <div class="admission-tabs__panel" role="tabpanel" id="process-secondary" aria-labelledby="process-secondary-tab" hidden><div class="admission-tabs__icon"><svg aria-hidden="true"><use href="#admission-cap" /></svg></div><p>{t.process.secondaryText}</p></div>
            </div>
          </section>
          <section class="admission-block admission-transfer" aria-labelledby="transfer-title">
            <div class="admission-section-label"><span>02</span><h2 id="transfer-title">{t.process.transfersTitle}</h2></div>
            <p>{t.process.transfersIntro}</p>
            <ul>{t.process.requirements.map((requirement) => <li><svg aria-hidden="true"><use href="#admission-check" /></svg>{requirement}</li>)}</ul>
            <p class="admission-note">{t.process.requirementsNote}</p>
          </section>
        </>}

        {section === 'fees' && <>
          <section class="admission-block" aria-label={t.fees.title}>
            <div class="admission-info-grid">
              {t.fees.cards.map((card, index) => <article class="admission-info-card"><span>0{index + 1}</span><h2>{card.title}</h2><p>{card.text}</p></article>)}
            </div>
          </section>
          <section class="admission-block" aria-labelledby="fees-table-title">
            <div class="admission-section-label"><span>01</span><h2 id="fees-table-title">{t.fees.tableTitle}</h2></div>
            <div class="admission-table-wrap"><table><thead><tr><th scope="col">{t.fees.level}</th><th scope="col">{t.fees.tuition}</th><th scope="col">{t.fees.pension}</th></tr></thead><tbody><tr><th scope="row">{t.fees.primary}</th><td>{t.fees.onRequest}</td><td>{t.fees.onRequest}</td></tr><tr><th scope="row">{t.fees.secondary}</th><td>{t.fees.onRequest}</td><td>{t.fees.onRequest}</td></tr></tbody></table></div>
            <p class="admission-note">{t.fees.note}</p>
          </section>
          <section class="admission-block admission-highlight" aria-labelledby="conditions-title"><div class="admission-highlight__icon"><svg aria-hidden="true"><use href="#admission-check" /></svg></div><div><h2 id="conditions-title">{t.fees.conditionsTitle}</h2><p>{t.fees.conditionsText}</p></div></section>
        </>}

        {section === 'vacancies' && <>
          <section class="admission-block" aria-labelledby="vacancies-table-title">
            <div class="admission-section-label"><span>01</span><h2 id="vacancies-table-title">{t.vacancies.tabsTitle}</h2></div>
            <div class="admission-tabs" data-admission-tabs>
              <div class="admission-tabs__list" role="tablist" aria-label={t.vacancies.tabsTitle}>
                <button type="button" role="tab" id="vacancies-primary-tab" aria-controls="vacancies-primary" aria-selected="true" tabindex="0">{t.vacancies.primary}</button>
                <button type="button" role="tab" id="vacancies-secondary-tab" aria-controls="vacancies-secondary" aria-selected="false" tabindex="-1">{t.vacancies.secondary}</button>
              </div>
              <div class="admission-tabs__panel admission-tabs__panel--table" role="tabpanel" id="vacancies-primary" aria-labelledby="vacancies-primary-tab"><div class="admission-table-wrap"><table><thead><tr><th scope="col">{t.vacancies.grade}</th><th scope="col">{t.vacancies.availability}</th></tr></thead><tbody>{t.vacancies.primaryGrades.map((grade) => <tr><th scope="row">{grade}</th><td>{t.vacancies.onRequest}</td></tr>)}</tbody></table></div></div>
              <div class="admission-tabs__panel admission-tabs__panel--table" role="tabpanel" id="vacancies-secondary" aria-labelledby="vacancies-secondary-tab" hidden><div class="admission-table-wrap"><table><thead><tr><th scope="col">{t.vacancies.grade}</th><th scope="col">{t.vacancies.availability}</th></tr></thead><tbody>{t.vacancies.secondaryGrades.map((grade) => <tr><th scope="row">{grade}</th><td>{t.vacancies.onRequest}</td></tr>)}</tbody></table></div></div>
            </div>
          </section>
          <section class="admission-block admission-highlight" aria-labelledby="vacancies-note-title"><div class="admission-highlight__icon"><svg aria-hidden="true"><use href="#admission-check" /></svg></div><div><h2 id="vacancies-note-title">{t.vacancies.noteTitle}</h2><p>{t.vacancies.note}</p></div></section>
        </>}

        <section class="admission-cta" aria-label={t.ctaTitle}>
          <div><span class="admission-eyebrow">{t.admission}</span><h2>{t.ctaTitle}</h2><p>{t.ctaText}</p></div>
          <a class="admission-button admission-button--light" href={applyHref}>{t.apply}<svg aria-hidden="true"><use href="#admission-arrow" /></svg></a>
        </section>
      </>}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-admission-tabs]').forEach((tabs) => {
    const buttons = Array.from(tabs.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const select = (chosen: HTMLButtonElement) => {
      buttons.forEach((button) => {
        const active = button === chosen;
        button.setAttribute('aria-selected', String(active));
        button.tabIndex = active ? 0 : -1;
        const panel = document.getElementById(button.getAttribute('aria-controls') || '');
        if (panel) panel.hidden = !active;
      });
    };
    buttons.forEach((button, index) => {
      button.addEventListener('click', () => select(button));
      button.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
        event.preventDefault();
        const next = buttons[(index + (event.key === 'ArrowRight' ? 1 : -1) + buttons.length) % buttons.length];
        select(next);
        next.focus();
      });
    });
  });
</script>

<style>
  .admission-symbols{position:absolute;width:0;height:0;overflow:hidden}
  .admission-shell{background:linear-gradient(180deg,#f7faff 0,#fff 36%);padding:66px 0 100px;color:#14324f}
  .admission-shell--interior{padding-top:54px}
  .admission-shell__grid{display:grid;grid-template-columns:246px minmax(0,1fr);gap:62px;align-items:start}
  .admission-side{position:sticky;top:28px;padding:23px 0 0}
  .admission-side__heading{display:flex;align-items:center;gap:11px;padding:0 16px 20px;color:#073b76;font:800 .88rem var(--font-heading);letter-spacing:.07em;text-transform:uppercase}
  .admission-side__mark{width:7px;height:25px;background:#ff9900;border-radius:4px}
  .admission-nav{display:grid;gap:5px;border-top:1px solid #dbe6f1;padding-top:14px}
  .admission-nav__link{display:grid;grid-template-columns:29px 1fr 15px;align-items:center;gap:9px;min-height:60px;padding:11px 13px;border-radius:12px;color:#34526d;text-decoration:none;font-size:.89rem;font-weight:700;line-height:1.35;transition:background .2s,color .2s,transform .2s}
  .admission-nav__link:hover{background:#eaf3fc;color:#003d82;transform:translateX(2px)}
  .admission-nav__link.is-active{background:#e5f1ff;color:#003d82;box-shadow:inset 3px 0 #ff9900}
  .admission-nav__number{color:#f49a18;font:800 .77rem var(--font-heading)}
  .admission-nav__link svg,.admission-button svg,.admission-pathway__card svg{width:17px;height:17px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
  .admission-nav__link svg{opacity:0;transition:opacity .2s}.admission-nav__link:hover svg,.admission-nav__link.is-active svg{opacity:1}
  .admission-side__help{margin-top:32px;padding:25px 21px 23px;border-radius:17px;background:#073e7e;color:#fff;box-shadow:0 12px 25px rgba(5,54,110,.13)}
  .admission-side__help-icon{display:grid;place-items:center;width:30px;height:30px;margin-bottom:16px;border:1px solid rgba(255,255,255,.55);border-radius:50%;font-weight:800}
  .admission-side__help strong{font:800 1.02rem var(--font-heading)}.admission-side__help p{margin:8px 0 18px;color:#d7e7f9;font-size:.81rem;line-height:1.5}
