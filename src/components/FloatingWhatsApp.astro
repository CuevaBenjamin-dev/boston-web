---
import { whatsappDisplay, whatsappHref } from '../utils/whatsapp';

interface Props { lang?: 'es' | 'en' }
const { lang = 'es' } = Astro.props;
const label = lang === 'es'
  ? `Escríbenos por WhatsApp al ${whatsappDisplay}`
  : `Message us on WhatsApp at ${whatsappDisplay}`;
---

<a class="floating-whatsapp" href={whatsappHref} target="_blank" rel="noopener noreferrer"
  aria-label={label} title={label} transition:persist="floating-whatsapp">
  <img src="/icons/whatsapp-white.svg" alt="" width="32" height="32" aria-hidden="true" />
</a>

<style>
  .floating-whatsapp {
    position: fixed;
    right: max(20px, calc(env(safe-area-inset-right) + 16px));
    bottom: max(20px, calc(env(safe-area-inset-bottom) + 16px));
    z-index: 120;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #25d366;
    color: #fff;
    box-shadow: 0 5px 18px rgba(0, 58, 28, .28);
    text-decoration: none;
    transition: transform .2s ease, box-shadow .2s ease;
  }
  .floating-whatsapp img { display: block; width: 32px; height: 32px; }
  .floating-whatsapp:hover { transform: translateY(-2px); box-shadow: 0 7px 22px rgba(0, 58, 28, .36); }
  .floating-whatsapp:focus-visible { outline: 3px solid #003d82; outline-offset: 3px; }
  @media (max-width: 600px) {
    .floating-whatsapp { width: 54px; height: 54px; }
    .floating-whatsapp img { width: 31px; height: 31px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .floating-whatsapp { transition: none; }
  }
</style>
