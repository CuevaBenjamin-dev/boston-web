---
import { whatsappDisplay, whatsappHref } from '../utils/whatsapp';

interface Props { lang?: 'es' | 'en' }
const { lang = 'es' } = Astro.props;
const label = lang === 'es'
  ? `Escríbenos por WhatsApp al ${whatsappDisplay}`
  : `Message us on WhatsApp at ${whatsappDisplay}`;
---

<a class="floating-whatsapp" href={whatsappHref} target="_blank" rel="noopener noreferrer"
  aria-label={label} title={label} transition:persist="floating-whatsapp">
  <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2.2"
    stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M16 3a13 13 0 0 0-11 20L3 29l6-2a13 13 0 1 0 7-24Z" />
    <path d="M10 10c0 6 6 12 12 12l2-3-4-3-2 2c-2-1-3-2-4-4l-3 2Z" />
  </svg>
</a>

<style>
  .floating-whatsapp {
    position: fixed;
    right: max(20px, calc(env(safe-area-inset-right) + 16px));
    bottom: max(20px, calc(env(safe-area-inset-bottom) + 16px));
    z-index: 120;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #25d366;
    color: #fff;
    box-shadow: 0 5px 18px rgba(0, 58, 28, .28);
    text-decoration: none;
    transition: transform .2s ease, box-shadow .2s ease;
  }
  .floating-whatsapp svg { width: 31px; height: 31px; }
  .floating-whatsapp:hover { transform: translateY(-2px); box-shadow: 0 7px 22px rgba(0, 58, 28, .36); }
  .floating-whatsapp:focus-visible { outline: 3px solid #003d82; outline-offset: 3px; }
  @media (max-width: 600px) {
    .floating-whatsapp { width: 54px; height: 54px; }
    .floating-whatsapp svg { width: 30px; height: 30px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .floating-whatsapp { transition: none; }
  }
</style>
