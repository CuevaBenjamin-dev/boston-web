{
  "name": "boston-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-06",
  "observability": { "enabled": true },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "boston-web-db",
    "database_id": "50d20d93-7b59-4bd0-8d06-448fd5f61673",
    "migrations_dir": "migrations"
  }],
  "vars": {
    "ORIGENES_PERMITIDOS": "https://bostonbbs.com,https://www.bostonbbs.com,https://boston-web.cueva-dev.workers.dev",
    "TURNSTILE_HOSTNAMES": "bostonbbs.com,www.bostonbbs.com,boston-web.cueva-dev.workers.dev",
    "VALANA_API_URL": "https://api.bostonbbs.com"
  },
  "triggers": { "crons": ["*/5 * * * *"] },
  "secrets": {
    "required": ["TURNSTILE_SECRET_KEY", "VALANA_INTEGRATION_TOKEN"]
  }
}
